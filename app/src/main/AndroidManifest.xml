<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_demo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotificationDemo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".pipeline.InactivityReceiver"
            android:exported="false" />

        <receiver
            android:name=".pipeline.PipelineNotificationActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".pipeline.StreakReceiver"
            android:exported="false" />

        <receiver
            android:name=".pipeline.ReminderReceiver"
            android:exported="false" />

    </application>
</manifest>
